# Frozen runtime/model provenance uses byte hashes; keep source bytes stable on checkout.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*requirements*.txt text eol=lf
*.joblib binary
*.npz binary
*.npy binary

# Keep ignore and text documentation stable after consolidating attributes.
.gitignore text eol=lf
.gitattributes text eol=lf
*.txt text eol=lf
